@startuml CleanCravings_UseCaseDiagram
' SC2006 SCSL Group 4. Use case model v2.0 (Lab 5), synchronised with the prototype.
' Grey use cases are planned and not built yet. The SRS (docs/lab5) has the descriptions.
' smetana = PlantUML's built-in layout engine, so this renders without Graphviz installed
!pragma layout smetana
title CleanCravings - Use Case Diagram (v2.0, Lab 5)
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
left to right direction
skinparam usecase {
  BackgroundColor #FBF7F0
  BorderColor #7A2E1F
  BackgroundColor<<planned>> #EEEEEE
  BorderColor<<planned>> #9E9E9E
  FontColor<<planned>> #616161
}

actor "Guest" as Guest
actor "Signed-in Diner" as Diner
actor "Scheduler\n(GitHub Actions, daily)" as Scheduler
actor "Google Sign-In\n(Supabase Auth)" as Google <<External Service>>
actor "OneMap (SLA)" as OneMap <<External Service>>
actor "NEA via data.gov.sg\n(centres, closures)" as NEA <<External Service>>
actor "SFA Track Records\n(Excel export)" as SFA <<External Service>>
actor "HPB via data.gov.sg\n(Healthier Dining)" as HPB <<External Service>>

Diner -|> Guest

rectangle "CleanCravings System" {
  package "Anyone (guest or signed in)" {
    usecase "UC-0.1: Log In with Google\nand Log Out" as UC01
    usecase "UC-2.0: Search & Filter\nHawker Centres" as UC20
    usecase "UC-3.0: View Stall Hygiene\nGrades & Track Records" as UC30
    usecase "UC-5.0: Recommend Clean,\nNearby Stalls" as UC50
    usecase "UC-6.0: Dish Recommendation" as UC60
    usecase "UC-10.0: Manage Accessibility" as UC100
    usecase "UC-2.1: Get Directions to\nHawker Centre" as UC21 <<planned>>
  }
  package "Signed in" {
    usecase "UC-1.0: Manage Health Profile" as UC10
    usecase "UC-4.0: Track Meal History\n(Visit Log)" as UC40
    usecase "UC-7.0: Bookmark Centre,\nStall or Dish" as UC70
    usecase "UC-8.0: Closure Alerts for\nBookmarked Centres" as UC80
    usecase "UC-4.1: View Weekly\nHealth Digest" as UC41 <<planned>>
    usecase "UC-4.2: Export Health\nSummary Report" as UC42 <<planned>>
    usecase "UC-9.0: Submit Stall-to-Dish\nReport" as UC90 <<planned>>
    usecase "UC-11.0: Rate and Comment\non Hawker Stall" as UC110 <<planned>>
  }
  package "Background" {
    usecase "UC-12.0: Refresh Official Data" as UC120
  }
}

Guest --> UC01
Guest --> UC20
Guest --> UC30
Guest --> UC50
Guest --> UC60
Guest --> UC100
Guest --> UC21

Diner --> UC10
Diner --> UC40
Diner --> UC70
Diner --> UC80
Diner --> UC41
Diner --> UC42
Diner --> UC90
Diner --> UC110

Scheduler --> UC120

UC01 --> Google
UC20 --> OneMap
UC21 --> OneMap
UC120 --> NEA
UC120 --> SFA
UC120 --> HPB

UC20 ..> UC30 : <<include>>
UC21 ..> UC20 : <<extend>>
UC80 ..> UC70 : <<extend>>
UC120 ..> UC80 : <<include>>
UC41 ..> UC40 : <<extend>>
UC42 ..> UC40 : <<extend>>
UC41 ..> UC60 : <<include>>

legend right
  v2.0 (Lab 5) changes from v1.0.1
  * Actor split into Guest and Signed-in Diner
    (a Signed-in Diner can do everything a Guest can)
  * UC-5.0 is now the "For you" stall picks
  * UC-7.0 also bookmarks stalls
  * New UC-12.0: daily sync of NEA, SFA and HPB data,
    outside the request path (NFR-9, NFR-10)
  * Grey = planned, not built in this prototype
endlegend
@enduml
