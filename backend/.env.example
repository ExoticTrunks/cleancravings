# Local dev uses SQLite out of the box. For Supabase, use the pooled Postgres connection string:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./cleancravings.db

# Auth. Leave SUPABASE_URL empty to use dev logins ("dev:<email>" tokens), handy before Supabase is set up.
SUPABASE_URL=
# Only for older Supabase projects that still use the shared HS256 JWT secret
SUPABASE_JWT_SECRET=
DEV_AUTH=true

# Optional data.gov.sg API key (raises rate limits for the ETL scripts)
DATA_GOV_API_KEY=

# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGINS=http://localhost:5173
